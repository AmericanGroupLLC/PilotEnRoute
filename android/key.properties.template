# ─── Android Release Signing Configuration ───────────────────────────────────
# Copy this file to key.properties (same directory) and fill in your values.
# NEVER commit key.properties to version control — it is in .gitignore
#
# To generate a keystore:
#   keytool -genkey -v -keystore pilotenroute.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias pilotenroute
#
storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=pilotenroute
storeFile=../pilotenroute.jks
