# Fastlane - PilotEnRoute (com.americangroupllc.pilotenroute)
#
# Auth is entirely env-driven so the same lanes run locally and in CI with no
# secrets in the repo.
#
#   iOS:     ASC_KEY_CONTENT (base64 .p8), ASC_KEY_ID, ASC_ISSUER_ID
#   Android: PLAY_JSON_KEY_FILE (path to a Play service-account JSON)
#
# Generated by store-kit/build_app.py. Edit the generator, not this file.

default_platform(:ios)

APP_ID = "com.americangroupllc.pilotenroute".freeze
AAB_PATH = File.expand_path(
  "../build/app/outputs/bundle/release/app-release.aab", __dir__
).freeze

def asc_api_key
  key = ENV["ASC_KEY_CONTENT"].to_s.strip
  UI.user_error!("ASC_KEY_CONTENT is empty - set the base64 .p8 as a secret") if key.empty?
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: key,
    is_key_content_base64: true,
    in_house: false
  )
end

def latest_ipa
  ipa = Dir[File.expand_path("../build/ios/ipa/*.ipa", __dir__)]
        .max_by { |f| File.mtime(f) }
  UI.user_error!("No .ipa in build/ios/ipa - run the ios build lane first") if ipa.nil?
  ipa
end

# fastlane runs under `bundle exec`; handing that env to Flutter breaks its
# CocoaPods detection. Strip the bundler vars for Flutter subprocesses.
def flutter_sh(cmd)
  runner = lambda { sh("cd .. && flutter #{cmd}") }
  if defined?(Bundler) && Bundler.respond_to?(:with_unbundled_env)
    Bundler.with_unbundled_env(&runner)
  else
    runner.call
  end
end

platform :ios do
  desc "Run the Flutter test suite"
  lane :test do
    flutter_sh("test")
  end

  desc "Build a release IPA"
  lane :build do
    flutter_sh("build ipa --release --flavor prod")
  end

  desc "Upload the listing metadata only (no binary)"
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      skip_binary_upload: true,
      skip_screenshots: true,
      overwrite_screenshots: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Build and ship to TestFlight for internal testing"
  lane :beta do
    build
    upload_to_testflight(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      ipa: latest_ipa,
      skip_waiting_for_build_processing: true
    )
    # dSYMs only exist when the archive was produced locally; skip quietly
    # rather than failing the lane on a machine that only downloaded the IPA.
    dsyms = File.expand_path(
      "../build/ios/archive/Runner.xcarchive/dSYMs", __dir__
    )
    if File.directory?(dsyms) && ENV["CRASHLYTICS_ENABLED"] == "1"
      upload_symbols_to_crashlytics(dsym_path: dsyms)
    else
      UI.message("Skipping dSYM upload (no local archive, or "                  "CRASHLYTICS_ENABLED != 1)")
    end
  end

  desc "Upload build + metadata + screenshots to TestFlight/App Store"
  lane :release do
    test
    build
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      ipa: latest_ipa,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end
end

platform :android do
  desc "Build a release AAB"
  lane :build do
    flutter_sh("build appbundle --release --flavor prod")
  end

  desc "Upload the Play listing metadata only (no binary)"
  lane :metadata do
    upload_to_play_store(
      package_name: "com.americangroupllc.pilotenroute",
      json_key: ENV.fetch("PLAY_JSON_KEY_FILE", "fastlane/play-service-account.json"),
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end

  desc "Upload AAB to the Play internal track"
  lane :beta do
    build
    upload_to_play_store(
      package_name: "com.americangroupllc.pilotenroute",
      json_key: ENV.fetch("PLAY_JSON_KEY_FILE", "fastlane/play-service-account.json"),
      aab: AAB_PATH,
      track: "internal",
      release_status: "draft"
    )
  end

  desc "Upload AAB + listing to Play production as a draft"
  lane :release do
    build
    upload_to_play_store(
      package_name: "com.americangroupllc.pilotenroute",
      json_key: ENV.fetch("PLAY_JSON_KEY_FILE", "fastlane/play-service-account.json"),
      aab: AAB_PATH,
      track: "production",
      release_status: "draft"
    )
  end
end
