#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
.localflutter/

# Real QA credentials for internal builds — never commit
env/secrets.json

# Gradle output under the Android module (the root-anchored /build/ above
# does not reach it).
android/build/
android/.gradle/
android/.kotlin/

# ── Signing and delivery secrets — never commit ──────────────────────────────
# An upload keystore in git is unrecoverable: the key is public from the moment
# it is pushed, and with Play App Signing off the listing can never be updated
# again. The Firebase config files are deliberately NOT here — Google documents
# them as non-secret, they ship inside the binary anyway, and CI needs them in
# the checkout for the Crashlytics Gradle plugin to apply and upload a mapping.
**/key.properties
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
*.cer
**/fastlane/play-service-account.json
**/fastlane/*.json.enc
env/*.json
!env/*.example.json
!env/example.json
